# Cüzdan — Çevre Değişkenleri
# Bu dosyayı kopyalayıp .env adıyla kaydedin
# .env dosyası GIT'E DAHİL EDİLMEMELİDİR

GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars
PII_SALT=change_this_to_a_random_pii_salt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# DEV_SECRET_KEY_OK=1  # Geliştirmede SECRET_KEY yoksa stabil bir geliştirme anahtarı kullanılır.
# DEV_SECRET_KEY=dev_secret_key_for_local_development_only

DATABASE_URL=./data/cuzdan.db
